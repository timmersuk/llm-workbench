{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug llm-workbench server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "showLog": true
    },
    {
      "name": "Debug llm-workbench tray",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/tray",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "showLog": true
    },
    {
      "name": "Run frontend (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "run", "dev", "--host", "127.0.0.1", "--port", "5173"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
