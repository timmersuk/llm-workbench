{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "pnpm@latest", "run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:AGENT_REPOS_ROOT = (Resolve-Path '..').Path; go run ./cmd/server"],
      "cwd": ".",
      "port": 8080
    }
  ]
}
